# Wails / frontend build output
xtm/build/bin
node_modules
xtm/frontend/dist
tam/build/bin
tam/frontend/dist

# Release artifacts (produced by scripts/release.ps1)
dist/

# Go
*.exe
*.test
*.out
go.work.sum

# Local database (portable-mode DB, if ever placed in-repo)
*.db
*.db-journal
*.db-wal

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Tooling artifacts
.playwright-mcp/
.superpowers/
.gstack/
.claude/
.claude-flow/
.agents/
.impeccable/
skills-lock.json
agentdb.rvf
agentdb.rvf.lock
.python-version

docs/dist/
docs/.env
docs/Makefile
docs/user_doc_config.yml

# The toolkit env beside each guide's Makefile, machine-local like docs/.env
# above. It was tracked at docs/user-guide/.env until the guide split gave
# each app's folder one of its own, which made the inconsistency visible.
docs/user-guide/.env
docs/user-guide/*/.env

# Generated user-guide build output. The toolkit writes dist/ beside the
# config it was run with, and build/<version>/ for the rendered PDF, so each
# app's guide folder has both.
docs/user-guide/*/dist/
docs/user-guide/*/build/

eslint-report.json

# local agent work notes (briefs, reports, ledgers)
.work/
.worktrees/

# slop-mop working directory (machine-local state)
.slopmop/

# slop-mop pristine default config, regenerated by `sm init`
.sb_config.json.template

# Local working material: the overview decks, the template they are built
# from, and the spreadsheets behind them. They stay on disk and out of the
# repo, because a binary no review can read is worth less in here than the
# 3 MB it costs every clone. references/ keeps its tracked screenshots.
assets/
deck/
references/*.xlsx
tam/*.xlsx
