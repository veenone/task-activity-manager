# name<TAB>command printing one number. C7: these fall or hold, never grow.
# Raising one by hand needs a reason in the commit message.
files_over_400	git ls-files "*.go" "*.ts" "*.tsx" | grep -v wailsjs | while read f; do n=$(wc -l < "$f"); [ "$n" -gt 400 ] && echo x; done | wc -l
ui_em_dashes	git ls-files "*/frontend/src/*.tsx" "*/frontend/src/*.ts" | grep -v ".test." | xargs grep -h -- "—" 2>/dev/null | grep -vE "^\s*(//|\*|/\*)" | wc -l
unscoped_todos	git ls-files "*.go" | xargs grep -h "TODO" 2>/dev/null | grep -vE "TODO\((tam|xtm)\)" | wc -l
bespoke_modals	git ls-files "*/frontend/src/*.tsx" | xargs grep -lE "className=\"[^\"]*(modal|overlay|backdrop)" 2>/dev/null | while read f; do grep -q "@agile-suite/core" "$f" || echo x; done | wc -l
eslint_a11y	node scripts/lint-count.js jsx-a11y/
eslint_max_lines	node scripts/lint-count.js max-lines
eslint_no_console	node scripts/lint-count.js no-console
eslint_problems	node scripts/lint-count.js
hardcoded_hex	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" | xargs grep -ohE "#[0-9a-fA-F]{3,8}\b" 2>/dev/null | wc -l
hardcoded_px_font	git ls-files "tam/frontend/src/*.css" | xargs grep -ohE "font-size: *[0-9.]+px" 2>/dev/null | wc -l
