# name<TAB>command printing one number. C7: these fall or hold, never grow.
# Raising one by hand needs a reason in the commit message.
files_over_400	git ls-files "*.go" "*.ts" "*.tsx" | node scripts/files-over-400.js
ui_em_dashes	git ls-files "*/frontend/src/*.tsx" "*/frontend/src/*.ts" | node scripts/ui-em-dashes.js
unscoped_todos	git ls-files "*.go" | xargs grep -h "TODO" 2>/dev/null | grep -vE "TODO\((tam|xtm)\)" | wc -l
bespoke_modals	git ls-files "*/frontend/src/*.tsx" | node scripts/bespoke-modals.js
eslint_a11y	node scripts/lint-count.js jsx-a11y/
eslint_max_lines	node scripts/lint-count.js max-lines
eslint_no_console	node scripts/lint-count.js no-console
eslint_problems	node scripts/lint-count.js
hardcoded_hex	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" "frontend/core/styles/primitives.css" | xargs cat | perl -0pe 's{/\*.*?\*/}{}gs' | grep -oE "#[0-9a-fA-F]{3,8}\b" | wc -l
hardcoded_px_font	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" | xargs cat | perl -0pe 's{/\*.*?\*/}{}gs' | grep -oE "font-size: *[0-9.]+px" | wc -l
raw_radius	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" "frontend/core/*.css" ":!frontend/core/styles/tokens.css" | xargs cat | perl -0pe 's{/\*.*?\*/}{}gs' | grep -oE "border-radius: *[^;}]*[0-9.]+px[^;}]*" | wc -l
raw_shadow	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" "frontend/core/*.css" ":!frontend/core/styles/tokens.css" | xargs cat | perl -0pe 's{/\*.*?\*/}{}gs' | tr '\n' ' ' | grep -oE "box-shadow: *[^;}]*(rgba?|hsla?|oklch|oklab|lab|lch)\([^;}]*" | wc -l
bare_focus	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" "frontend/core/*.css" ":!frontend/core/styles/tokens.css" | xargs cat | perl -0pe 's{/\*.*?\*/}{}gs' | grep -oE ":focus([^a-zA-Z0-9_-]|$)" | wc -l
outline_none	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" "frontend/core/*.css" ":!frontend/core/styles/tokens.css" | xargs cat | perl -0pe 's{/\*.*?\*/}{}gs' | grep -oE "outline: *none\b" | wc -l
raw_duration	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" "frontend/core/*.css" ":!frontend/core/styles/tokens.css" | xargs cat | perl -0pe 's{/\*.*?\*/}{}gs' | grep -oE "transition(-duration)?: *[^;}]*[0-9.]+(ms|s)\b[^;}]*" | wc -l
unguarded_motion	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" "frontend/core/*.css" ":!frontend/core/styles/tokens.css" | xargs perl -0777 -ne 's{/\*.*?\*/}{}gs; $n++ if /(^|[\s;])transition(-[a-z]+)?:/ && !/prefers-reduced-motion/; END { print "$n\n" }'
transition_all	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" "frontend/core/*.css" ":!frontend/core/styles/tokens.css" | xargs cat | perl -0pe 's{/\*.*?\*/}{}gs' | grep -oE "transition: *all\b" | wc -l
raw_z_index	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" "frontend/core/*.css" ":!frontend/core/styles/tokens.css" | xargs cat | perl -0pe 's{/\*.*?\*/}{}gs' | grep -oE "z-index: *-?[0-9]+" | wc -l
offscale_breakpoints	git ls-files "tam/frontend/src/*.css" "xtm/frontend/src/*.css" "frontend/core/*.css" ":!frontend/core/styles/tokens.css" | xargs cat | perl -0pe 's{/\*.*?\*/}{}gs' | grep -oE "(max|min)-width: *[0-9]+px\)" | grep -vE ": *(560|720|900)px\)" | wc -l
